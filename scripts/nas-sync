#!/usr/bin/env sh
set -eu

PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
NAS_APP_DIR=/volume1/docker/wiki-game/app

cd "$PROJECT_ROOT"

COPYFILE_DISABLE=1 tar \
  --exclude='./.venv' \
  --exclude='./.idea' \
  --exclude='*/__pycache__' \
  --exclude='*.pyc' \
  -czf - . | ssh wiki-game-nas "mkdir -p '$NAS_APP_DIR' && tar -xzf - -C '$NAS_APP_DIR' && find '$NAS_APP_DIR' -name '._*' -type f -delete && cp '$NAS_APP_DIR/docker-compose.nas.yml' '$NAS_APP_DIR/docker-compose.yml'"
